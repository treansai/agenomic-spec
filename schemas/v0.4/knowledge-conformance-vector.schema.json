{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenomic.dev/spec/v0.4/knowledge-conformance-vector.schema.json",
  "title": "Agenomic knowledge base conformance vector (v0.4)",
  "description": "One cross-language conformance vector under conformance/vectors/knowledge/ (RFC 0014). The envelope is the `agenomic.conformance_vector/v1` envelope of RFC 0012; this schema fixes the knowledge suites and their input and output shapes. Every implementation runs the vectors whose `consumers` name it and asserts exact equality on every member present in `expected`, and on nothing else.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite", "id", "intent", "consumers", "input", "expected"],
  "properties": {
    "schema": { "const": "agenomic.conformance_vector/v1" },
    "suite": { "enum": ["section", "digest", "ref", "tokens", "lexical", "bm25"] },
    "id": { "type": "string", "pattern": "^K[SDRTLM][0-9]{3}$" },
    "intent": { "type": "string", "minLength": 1 },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["rust-cloud", "rust-cli", "python", "typescript"] }
    },
    "input": { "type": "object" },
    "expected": {
      "type": "object",
      "required": ["ok"],
      "properties": { "ok": { "type": "boolean" } },
      "if": { "properties": { "ok": { "const": false } } },
      "then": {
        "additionalProperties": false,
        "required": ["ok", "error"],
        "properties": {
          "ok": { "const": false },
          "error": { "$ref": "#/$defs/error" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "suite": { "const": "section" } } },
      "then": {
        "properties": {
          "id": { "pattern": "^KS" },
          "input": { "$ref": "#/$defs/sectionInput" },
          "expected": { "$ref": "#/$defs/sectionSuccess" }
        }
      }
    },
    {
      "if": { "properties": { "suite": { "const": "digest" } } },
      "then": {
        "properties": {
          "id": { "pattern": "^KD" },
          "input": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["operation", "document"],
                "properties": {
                  "operation": { "const": "digest" },
                  "document": {},
                  "projection": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["rule", "from"],
                    "properties": {
                      "rule": { "enum": ["index_identity", "retrieval_params", "embedding_space"] },
                      "from": { "type": "object" }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["operation", "document_content_digest", "chunking_digest", "ordinal"],
                "properties": {
                  "operation": { "const": "chunk_id" },
                  "document_content_digest": { "$ref": "knowledge-common.schema.json#/$defs/sha256Digest" },
                  "chunking_digest": { "$ref": "knowledge-common.schema.json#/$defs/sha256Digest" },
                  "ordinal": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["operation", "text"],
                "properties": {
                  "operation": { "const": "chunk_content_digest" },
                  "text": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["operation", "query"],
                "properties": {
                  "operation": { "const": "query_digest" },
                  "query": { "type": "string" }
                }
              }
            ]
          },
          "expected": {
            "if": { "properties": { "ok": { "const": true } } },
            "then": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "required": ["ok", "document_type", "canonical", "digest"],
                  "properties": {
                    "ok": { "const": true },
                    "document_type": { "type": "string", "pattern": "^agenomic\\.[a-z_]+/v[0-9]+$" },
                    "canonical": { "type": "string" },
                    "digest": { "$ref": "knowledge-common.schema.json#/$defs/sha256Digest" }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": ["ok", "chunk_id"],
                  "properties": {
                    "ok": { "const": true },
                    "chunk_id": { "$ref": "knowledge-common.schema.json#/$defs/chunkId" }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": ["ok", "content_digest"],
                  "properties": {
                    "ok": { "const": true },
                    "content_digest": { "$ref": "knowledge-common.schema.json#/$defs/sha256Digest" }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": ["ok", "normalized", "digest"],
                  "properties": {
                    "ok": { "const": true },
                    "normalized": { "type": "string", "minLength": 1 },
                    "digest": { "$ref": "knowledge-common.schema.json#/$defs/sha256Digest" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "suite": { "const": "ref" } } },
      "then": {
        "properties": {
          "id": { "pattern": "^KR" },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "workspace_id"],
            "properties": {
              "ref": { "type": "string" },
              "workspace_id": {
                "anyOf": [
                  { "$ref": "knowledge-common.schema.json#/$defs/uuidLower" },
                  { "type": "null" }
                ]
              }
            }
          },
          "expected": {
            "if": { "properties": { "ok": { "const": true } } },
            "then": {
              "additionalProperties": false,
              "required": ["ok", "form", "workspace_id", "kb_id", "version", "document_id", "revision", "canonical"],
              "properties": {
                "ok": { "const": true },
                "form": { "enum": ["base", "document"] },
                "workspace_id": { "$ref": "knowledge-common.schema.json#/$defs/uuidLower" },
                "kb_id": { "$ref": "knowledge-common.schema.json#/$defs/kbId" },
                "version": { "type": ["integer", "null"] },
                "document_id": {
                  "anyOf": [
                    { "$ref": "knowledge-common.schema.json#/$defs/documentId" },
                    { "type": "null" }
                  ]
                },
                "revision": { "type": ["integer", "null"] },
                "canonical": { "$ref": "knowledge-common.schema.json#/$defs/knowledgeRef" }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "suite": { "const": "tokens" } } },
      "then": {
        "properties": {
          "id": { "pattern": "^KT" },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": { "text": { "type": "string" } }
          },
          "expected": {
            "additionalProperties": false,
            "required": ["ok", "token_count"],
            "properties": {
              "ok": { "const": true },
              "token_count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "suite": { "const": "lexical" } } },
      "then": {
        "properties": {
          "id": { "pattern": "^KL" },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": { "text": { "type": "string" } }
          },
          "expected": {
            "additionalProperties": false,
            "required": ["ok", "tokens"],
            "properties": {
              "ok": { "const": true },
              "tokens": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "suite": { "const": "bm25" } } },
      "then": {
        "properties": {
          "id": { "pattern": "^KM" },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query", "candidates", "k1", "b", "corpus"],
            "properties": {
              "query": { "type": "string" },
              "candidates": { "type": "array", "items": { "type": "string" } },
              "k1": { "$ref": "#/$defs/decimal" },
              "b": { "$ref": "#/$defs/decimal" },
              "corpus": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["documents", "average_length"],
                    "properties": {
                      "documents": { "type": "integer", "minimum": 0 },
                      "average_length": { "$ref": "#/$defs/decimal" }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          },
          "expected": {
            "additionalProperties": false,
            "required": ["ok", "ranked"],
            "properties": {
              "ok": { "const": true },
              "ranked": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["candidate", "score"],
                  "properties": {
                    "candidate": { "type": "integer", "minimum": 0 },
                    "score": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$" }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "decimal": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "reason": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "item": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "value_path": { "type": "string", "pattern": "^(/.*)?$" }
          }
        }
      }
    },
    "outlineBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["heading"],
          "properties": {
            "heading": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "text", "anchor", "tags"],
              "properties": {
                "level": { "type": "integer", "minimum": 1, "maximum": 9 },
                "text": { "type": "string" },
                "anchor": { "type": ["string", "null"] },
                "tags": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "type": "string" } }
        }
      ]
    },
    "sectionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "document_id", "fallback_title", "outline"],
      "properties": {
        "operation": { "const": "sections" },
        "document_id": { "$ref": "knowledge-common.schema.json#/$defs/documentId" },
        "fallback_title": { "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "text"],
          "properties": {
            "format": { "const": "markdown" },
            "text": { "type": "string" }
          }
        },
        "outline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "front_matter", "blocks"],
          "properties": {
            "title": { "type": ["string", "null"] },
            "front_matter": { "type": "object" },
            "blocks": { "type": "array", "items": { "$ref": "#/$defs/outlineBlock" } }
          }
        }
      }
    },
    "sectionSuccess": {
      "additionalProperties": false,
      "required": ["ok", "title", "content_digest", "token_count", "sections"],
      "properties": {
        "ok": { "const": true },
        "title": { "type": "string", "minLength": 1 },
        "content_digest": { "$ref": "knowledge-common.schema.json#/$defs/sha256Digest" },
        "token_count": { "type": "integer", "minimum": 0 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "section_id", "parent_section_id", "depth", "heading", "heading_path", "anchor", "content", "content_digest", "tags", "token_count"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 0 },
              "section_id": { "$ref": "knowledge-common.schema.json#/$defs/sectionId" },
              "parent_section_id": {
                "anyOf": [
                  { "$ref": "knowledge-common.schema.json#/$defs/sectionId" },
                  { "type": "null" }
                ]
              },
              "depth": { "type": "integer", "minimum": 0 },
              "heading": { "type": "string", "minLength": 1 },
              "heading_path": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "anchor": { "type": "string" },
              "content": { "type": "string" },
              "content_digest": { "$ref": "knowledge-common.schema.json#/$defs/sha256Digest" },
              "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "token_count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
