{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenomic.dev/spec/v0.3/coding-session.schema.json",
  "title": "Agenomic Coding Session (v0.3)",
  "description": "A coding-agent session (Claude Code, Codex) supervised by Agenomic (RFC 0013). origin fixes the control level: launched sessions are controllable, local_connected sessions are observed (policy hooks only), imported sessions are historical and never controllable. mode_effective is the requested mode, blocked or none: it is never silently lowered below or raised above mode_requested, and when a prerequisite of the requested mode fails, the session is blocked. An enforce session carries capabilities.pre_tool_control validated as supported_tested or partial.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "runtime",
    "origin",
    "control",
    "status",
    "mode_requested",
    "mode_effective",
    "created_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "runner_id": { "type": ["string", "null"], "format": "uuid" },
    "actor_id": { "type": ["string", "null"], "minLength": 1 },
    "runtime": { "type": "string", "enum": ["claude_code", "codex"] },
    "runtime_version": { "type": ["string", "null"] },
    "surface": {
      "type": ["string", "null"],
      "description": "Integration surface, for example sdk, cli_hooks, app_server."
    },
    "origin": { "type": "string", "enum": ["launched", "local_connected", "imported"] },
    "control": { "type": "string", "enum": ["controllable", "observed", "imported"] },
    "runtime_session_id": {
      "type": ["string", "null"],
      "description": "The runtime's native session id. Unique per (runner_id, runtime)."
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "starting",
        "running",
        "idle",
        "waiting_approval",
        "waiting_input",
        "interrupting",
        "stopping",
        "stopped",
        "failed",
        "lost"
      ],
      "description": "lost: no heartbeat within the lease; the process may still be running."
    },
    "workspace_id": { "type": ["string", "null"] },
    "repo": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "base_revision": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "policy_profile": { "type": ["string", "null"] },
    "policy_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "mode_requested": { "$ref": "#/$defs/governanceMode" },
    "mode_effective": {
      "type": "string",
      "enum": ["observe", "shadow", "enforce", "none", "blocked"],
      "description": "none: not yet connected. blocked: the requested mode could not be established; the session refuses actions."
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which coding tool ids are actually gated in this session. A protected badge is derived from mode_effective together with a non-empty protected list, never from mode_requested or notes. protected and not_covered are disjoint: a tool id is gated or not, never both.",
      "$comment": "Disjointness, enumerated per tool id (JSON Schema has no set-intersection keyword). The allOf below lists every id of coding-action.schema.json#/$defs/toolId; scripts/validate.js checks it stays in sync.",
      "allOf": [
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.fs.read" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.fs.read" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.fs.write" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.fs.write" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.fs.delete" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.fs.delete" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.shell.exec" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.shell.exec" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.shell.interactive_input" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.shell.interactive_input" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.git.read" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.git.read" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.git.commit" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.git.commit" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.git.push" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.git.push" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.git.destructive" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.git.destructive" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.dependency.install" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.dependency.install" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.network.fetch" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.network.fetch" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.mcp.call" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.mcp.call" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.agent_config.modify" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.agent_config.modify" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.subagent.spawn" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.subagent.spawn" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.web.search" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.web.search" } } } } }
        },
        {
          "if": { "properties": { "protected": { "contains": { "const": "coding.unknown" } } }, "required": ["protected"] },
          "then": { "properties": { "not_covered": { "not": { "contains": { "const": "coding.unknown" } } } } }
        }
      ],
      "properties": {
        "protected": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "coding-action.schema.json#/$defs/toolId" },
          "description": "Tool ids whose calls are gated by Agenomic in this session."
        },
        "not_covered": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "coding-action.schema.json#/$defs/toolId" },
          "description": "Tool ids whose calls are not gated in this session."
        },
        "notes": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 300 },
          "description": "Human-readable descriptions of the mechanisms behind the coverage (sandbox, settings not loaded, ...). Caveats about what is not covered go to limitations."
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Human-readable caveats, including what protection does not cover."
    },
    "capabilities": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/capabilityName" },
      "additionalProperties": { "$ref": "#/$defs/capabilityEntry" }
    },
    "tool_run_id": { "type": ["string", "null"] },
    "rmp_session_id": { "type": ["string", "null"] },
    "trace_id": { "type": ["string", "null"] },
    "pending_approvals": { "type": "integer", "minimum": 0 },
    "last_heartbeat_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "description": "Content capture opt-ins. Absent or false means metadata only.",
      "properties": {
        "conversation": { "type": "boolean", "default": false },
        "commands": { "type": "boolean", "default": false },
        "diffs": { "type": "boolean", "default": false },
        "outputs": { "type": "boolean", "default": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "origin": { "const": "launched" } }, "required": ["origin"] },
      "then": { "properties": { "control": { "const": "controllable" } } }
    },
    {
      "if": { "properties": { "origin": { "const": "local_connected" } }, "required": ["origin"] },
      "then": { "properties": { "control": { "const": "observed" } } }
    },
    {
      "if": { "properties": { "origin": { "const": "imported" } }, "required": ["origin"] },
      "then": { "properties": { "control": { "const": "imported" } } }
    },
    {
      "$comment": "No silent downgrade: a session that requested enforce is enforce, blocked, or not yet connected.",
      "if": { "properties": { "mode_requested": { "const": "enforce" } }, "required": ["mode_requested"] },
      "then": { "properties": { "mode_effective": { "enum": ["enforce", "blocked", "none"] } } }
    },
    {
      "$comment": "No silent downgrade: a session that requested shadow is shadow, blocked, or not yet connected.",
      "if": { "properties": { "mode_requested": { "const": "shadow" } }, "required": ["mode_requested"] },
      "then": { "properties": { "mode_effective": { "enum": ["shadow", "blocked", "none"] } } }
    },
    {
      "$comment": "No silent upgrade: a session that requested observe is observe, blocked, or not yet connected; it never returns binding (enforce) or recorded would-be (shadow) decisions the user did not ask for.",
      "if": { "properties": { "mode_requested": { "const": "observe" } }, "required": ["mode_requested"] },
      "then": { "properties": { "mode_effective": { "enum": ["observe", "blocked", "none"] } } }
    },
    {
      "$comment": "Enforce needs validated pre-tool control: a session is enforce only when capabilities.pre_tool_control is present with validated supported_tested or partial. unknown, unsupported or experimental never counts as protected, and an enforce request that depends on it is blocked; an absent capability does not count either.",
      "if": { "properties": { "mode_effective": { "const": "enforce" } }, "required": ["mode_effective"] },
      "then": {
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "required": ["pre_tool_control"],
            "properties": {
              "pre_tool_control": {
                "properties": { "validated": { "enum": ["supported_tested", "partial"] } }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "governanceMode": { "type": "string", "enum": ["observe", "shadow", "enforce"] },
    "capabilityName": {
      "type": "string",
      "enum": [
        "observe",
        "converse",
        "remote_approval",
        "pre_tool_control",
        "interrupt_turn",
        "stop_process",
        "resume",
        "file_diffs",
        "user_questions",
        "subagent_tracking"
      ]
    },
    "capabilityState": {
      "type": "string",
      "enum": ["supported_tested", "partial", "experimental", "unsupported", "unknown"]
    },
    "capabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["announced", "validated"],
      "properties": {
        "announced": { "$ref": "#/$defs/capabilityState" },
        "validated": { "$ref": "#/$defs/capabilityState" },
        "detail": { "type": "string" }
      }
    }
  }
}
